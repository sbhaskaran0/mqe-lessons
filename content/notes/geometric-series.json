     "id": "matrix-version-1",
     "blocks": [
      {
       "t": "math",
       "tex": "(I - A)^{-1} = I + A + A^2 + \\dots \\quad\\text{if every eigenvalue of } A \\text{ has } |\\lambda| < 1"
      },
      {
       "t": "prose",
       "md": "([Eigenvalues and Eigenvectors](note:eigenvalues-and-eigenvectors)). This is the input-output multiplier, and the solution of a stable linear dynamic system."
      }
     ],
     "words": 17,
