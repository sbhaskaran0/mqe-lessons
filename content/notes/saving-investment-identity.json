 "sections": [
  {
   "id": "in-plain-english",
   "heading": "In plain English",
   "role": "intuition",
   "steps": [
    {
     "id": "in-plain-english-1",
     "blocks": [
      {
       "t": "prose",
       "md": "In an economy that does not trade with the outside world and has no government, everything produced is either consumed or invested in new capital, and whatever people do not consume is saved. Put those two facts together and saving must equal investment — every dollar saved ends up financing a machine or a building. If households save a fixed share of their income, investment is that same share of output."
      },
      {
       "t": "callout",
       "kind": "why",
       "title": "Why it matters",
       "md": "It is the link between household saving behaviour and capital accumulation in growth models, and a check on any macro accounting.",
       "folded": false
      }
     ],
     "words": 94,
     "symbols": []
    }
   ]
  },
  {
   "id": "definition",
   "heading": "Definition",
   "role": "definition",
   "steps": [
    {
     "id": "definition-1",
     "blocks": [
      {
       "t": "prose",
       "md": "In a closed economy with no government, output is spent on consumption or investment, and whatever is not consumed is saved:"
      },
      {
       "t": "math",
       "tex": "Y = C + I, \\qquad S = Y - C \\quad\\Longrightarrow\\quad S = I"
      },
      {
       "t": "prose",
       "md": "Every unit saved becomes a unit of new capital."
      }
     ],
     "words": 30,
     "symbols": [
      "$Y$",
      "$C$",
      "$I$",
      "$S$"
     ]
    }
   ]
  },
  {
   "id": "with-a-constant-saving-rate",
   "heading": "With a constant saving rate",
   "role": "depth",
   "steps": [
    {
     "id": "with-a-constant-saving-rate-1",
     "blocks": [
      {
       "t": "prose",
       "md": "If households save a fixed fraction $s\\in(0,1)$ of income, $S = sY$, $C = (1-s)Y$ and"
      },
      {
       "t": "math",
       "tex": "I = sY"
      },
      {
       "t": "prose",
       "md": "Example: $Y = 100$ and $s = 0.3$ give $S = I = 30$ and $C = 70$."
      }
     ],
     "words": 13,
     "symbols": [
      "$Y$",
      "$C$",
      "$I$",
      "$S$",
      "$s$"
     ]
    }
   ]
  },
  {
   "id": "extensions-beyond-the-closed-economy-case",
   "heading": "Extensions (beyond the closed-economy case)",
   "role": "depth",
   "steps": [
    {
     "id": "extensions-beyond-the-closed-economy-case-1",
     "blocks": [
      {
       "t": "table",
       "md": "| Economy | Identity |\n| --- | --- |\n| Closed, no government | $S = I$ |\n| With government | $S_{private} + (T - G) = I$ |\n| Open | $S - I = NX$ (current account) |"
      }
     ],
     "words": 12,
     "symbols": [
      "$I$",
      "$S$",
      "$T$, $G$",
      "$NX$"
     ]
    }
   ]
  },
  {
